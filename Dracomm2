local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local function visibleFrom(origin, part)
    aimParams.FilterDescendantsInstances = {LP.Character, part.Parent}
    return workspace:Raycast(origin, part.Position - origin, aimParams) == nil
end

local function aimTarget()
    local mp = UIS:GetMouseLocation()
    local origin = Camera.CFrame.Position
    local best, bestD = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and alive(plr) then
            local head = plr.Character:FindFirstChild("Head") or root(plr)
            local p, on = Camera:WorldToViewportPoint(head.Position)
            if on and p.Z > 0 then
                local d = (Vector2.new(p.X, p.Y) - mp).Magnitude
                if d <= CFG.AimFOV and d < bestD and visibleFrom(origin, head) then
                    best, bestD = head, d
                end
            end
        end
    end
    return best
end

conns[#conns + 1] = RunService.RenderStepped:Connect(function()
    local mp = UIS:GetMouseLocation()
    fovRing.Visible = CFG.Aimbot and CFG.ShowFOV and CFG.KeyUnlocked
    fovRing.Position = UDim2.fromOffset(mp.X, mp.Y)
    fovRing.Size = UDim2.fromOffset(CFG.AimFOV * 2, CFG.AimFOV * 2)
    if CFG.KeyUnlocked and CFG.Aimbot and (rmbHeld or not CFG.AimHoldRMB) then
        local head = aimTarget()
        if head then
            local k = math.clamp(10 / CFG.AimSmooth, 0.02, 1)
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, head.Position), k)
        end
    end
end)

-- fling --------------------------------------------------------------------

local function nearestOther(range)
    local me = myRoot()
    if not me then return nil end
    local best, bestD = nil, range
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and alive(plr) then
            local d = (root(plr).Position - me.Position).Magnitude
            if d <= bestD then best, bestD = plr, d end
        end
    end
    return best
end

local FLING_STATES = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.PlatformStanding,
}

local function setFlingStates(hum, on)
    if not hum then return end
    for _, st in ipairs(FLING_STATES) do
        pcall(function() hum:SetStateEnabled(st, on) end)
    end
end

local function zeroRoot(m)
    if not m then return end
    m.AssemblyLinearVelocity = Vector3.zero
    m.AssemblyAngularVelocity = Vector3.zero
end

local function flingTarget(tgt, duration)
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    local t0 = os.clock()
    local phase = 0
    local done = false
    local conn

    setFlingStates(hum, false)

    conn = RunService.Heartbeat:Connect(function(dt)
        if done then return end
        local me, r = myRoot(), root(tgt)
        if not running or os.clock() - t0 > duration or not me or not r or not alive(tgt) then
            done = true
            conn:Disconnect()
            return
        end
        phase += dt
        local tv = r.AssemblyLinearVelocity
        local predicted = r.Position + tv * 0.1
        local orbit = Vector3.new(math.cos(phase * 7) * 1.5, 0.3, math.sin(phase * 7) * 1.5)
        me.CFrame = CFrame.new(predicted + orbit, predicted)
        me.AssemblyLinearVelocity = tv + Vector3.new(0, 15, 0)
        me.AssemblyAngularVelocity = Vector3.new(0, CFG.FlingPower, 0)
    end)

    while not done and running do task.wait() end
    if conn.Connected then conn:Disconnect() end
end

local function flingNearby()
    if flingBusy or not CFG.KeyUnlocked then return end
    flingBusy = true
    flingActive = true
    task.spawn(function()
        local m = myRoot()
        local home = m and m.CFrame
        local deadline = os.clock() + CFG.FlingTime

        while running and os.clock() < deadline do
            local tgt = nearestOther(CFG.FlingRange)
            if not tgt then
                task.wait(0.1)
            else
                flingTarget(tgt, math.min(1.2, deadline - os.clock()))
                task.wait(0.03)
            end
        end

        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        setFlingStates(hum, true)
        local mm = myRoot()
        zeroRoot(mm)
        if mm and home then mm.CFrame = home end
        flingActive = false
        flingBusy = false
    end)
end

task.spawn(function()
    while running do
        if CFG.KeyUnlocked and CFG.Fling and not flingBusy and nearestOther(CFG.FlingRange) then flingNearby() end
        task.wait(1)
    end
end)

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
    if not CFG.KeyUnlocked or not CFG.TouchFling or flingBusy then return end
    local me = myRoot()
    if me and nearestOther(CFG.TouchRange) then
        me.AssemblyAngularVelocity = Vector3.new(0, CFG.FlingPower * 0.6, 0)
    end
end)

-- anti-fling ---------------------------------------------------------------

local antiSaved = {}

local function antiFlingCollide()
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr ~= LP and plr.Character
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    antiSaved[part] = antiSaved[part] or true
                    part.CanCollide = false
                end
            end
        end
    end
end

local function antiFlingRestore()
    for part in pairs(antiSaved) do
        if part.Parent then pcall(function() part.CanCollide = true end) end
    end
    antiSaved = {}
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
    if not CFG.KeyUnlocked or not CFG.AntiFling or flingActive then return end
    local me = myRoot()
    if not me then return end
    local v = me.AssemblyLinearVelocity
    local w = me.AssemblyAngularVelocity
    if v.Magnitude > 120 or w.Magnitude > 45 then
        me.AssemblyLinearVelocity = Vector3.zero
        me.AssemblyAngularVelocity = Vector3.zero
    end
end)

task.spawn(function()
    local was = false
    while running do
        if CFG.KeyUnlocked and CFG.AntiFling then
            was = true
            antiFlingCollide()
        elseif was then
            was = false
            antiFlingRestore()
        end
        task.wait(0.25)
    end
end)

-- kill ---------------------------------------------------------------------

local function killAll()
    if killing or not CFG.KeyUnlocked then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local knife = char and (char:FindFirstChild("Knife") or LP.Backpack:FindFirstChild("Knife"))
    if not (hum and knife) then return end
    killing = true
    task.spawn(function()
        if knife.Parent ~= char then
            hum:EquipTool(knife)
            task.wait(0.15)
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if not (killing and running) then break end
            if plr ~= LP and alive(plr) then
                local r, m = root(plr), myRoot()
                local tool = LP.Character and LP.Character:FindFirstChild("Knife")
                if r and m and tool then
                    m.CFrame = r.CFrame * CFrame.new(0, 0, 2)
                    tool:Activate()
                end
                task.wait(CFG.KillDelay)
            end
        end
        killing = false
    end)
end

