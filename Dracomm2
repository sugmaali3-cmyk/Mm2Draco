local function stopFling()
	if flingThread then
		pcall(task.cancel, flingThread)
		flingThread = nil
	end
	flingTarget = nil
	local c = LP.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	if hum then
		hum.AutoRotate = true
		hum.PlatformStand = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
end

local function startFling(plr)
	stopFling()
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local targetChar = plr and plr.Character
	local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not (root and hum and hum.Health > 0 and targetRoot and targetHum and targetHum.Health > 0) then return end
	
	flingTarget = plr
	flingStartT = os.clock()
	local savedPivot = char:GetPivot()
	local savedAutoRotate = hum.AutoRotate
	local savedFallenHeight = workspace.FallenPartsDestroyHeight
	local savedSeatedEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Seated)
	hum.AutoRotate = false
	
	flingThread = task.spawn(function()
		local started = os.clock()
		local lastPos = targetRoot.Position
		local launchOrigin = lastPos
		local launched = false
		
		local function targetEscaped()
			if not targetRoot.Parent then return false end
			lastPos = targetRoot.Position
			local distance = (lastPos - launchOrigin).Magnitude
			local speed = targetRoot.AssemblyLinearVelocity.Magnitude
			return lastPos.Y <= savedFallenHeight + 30 or distance > 350 or (distance > 120 and speed > 200)
		end
		
		local function flingPosition(pos, angle)
			local cf = CFrame.new(targetRoot.Position) * pos * angle
			root.CFrame = cf
			char:PivotTo(cf)
			root.Velocity = Vector3.new(9e7, 9e8, 9e7)
			root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
		end
		
		pcall(function() workspace.FallenPartsDestroyHeight = 0 / 0 end)
		pcall(hum.SetStateEnabled, hum, Enum.HumanoidStateType.Seated, false)
		pcall(function() if sethiddenproperty then sethiddenproperty(LP, "SimulationRadius", math.huge) end end)
		
		pcall(function()
			local angle = 0
			while running and os.clock() - started < 2 do
				if not (root.Parent and hum.Health > 0 and targetRoot.Parent and targetHum.Health > 0) then break end
				if targetEscaped() then launched = true; break end
				local speed = targetRoot.AssemblyLinearVelocity.Magnitude
				angle += 100
				local steps
				if speed < 50 then
					local lead = targetHum.MoveDirection * speed / 1.25
					local rotation = CFrame.Angles(math.rad(angle), 0, 0)
					steps = {
						{ CFrame.new(0, 1.5, 0) + lead, rotation }, { CFrame.new(0, -1.5, 0) + lead, rotation },
						{ CFrame.new(0, 1.5, 0) + lead, rotation }, { CFrame.new(0, -1.5, 0) + lead, rotation },
						{ CFrame.new(0, 1.5, 0) + targetHum.MoveDirection, rotation }, { CFrame.new(0, -1.5, 0) + targetHum.MoveDirection, rotation },
					}
				else
					local flat, quarter = CFrame.new(), CFrame.Angles(math.rad(90), 0, 0)
					steps = {
						{ CFrame.new(0, 1.5, targetHum.WalkSpeed), quarter }, { CFrame.new(0, -1.5, -targetHum.WalkSpeed), flat },
						{ CFrame.new(0, 1.5, targetHum.WalkSpeed), quarter }, { CFrame.new(0, -1.5, 0), quarter },
						{ CFrame.new(0, -1.5, 0), flat }, { CFrame.new(0, -1.5, 0), quarter }, { CFrame.new(0, -1.5, 0), flat },
					}
				end
				for _, step in ipairs(steps) do
					flingPosition(step[1], step[2])
					task.wait()
					if targetEscaped() then launched = true; break end
				end
				if launched then break end
			end
		end)
		
		if root.Parent and hum.Health > 0 then
			char:PivotTo(savedPivot)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		pcall(function() workspace.FallenPartsDestroyHeight = savedFallenHeight end)
		pcall(hum.SetStateEnabled, hum, Enum.HumanoidStateType.Seated, savedSeatedEnabled)
		if hum and hum.Parent then
			hum.AutoRotate = savedAutoRotate
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		flingThread = nil
		flingTarget = nil
	end)
end

local function pickFlingTarget()
	if CFG.FlingAll then
		if os.clock() >= allNext then allIdx += 1; allNext = os.clock() + 1.5 end
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then list[#list + 1] = p end end
		if #list == 0 then return nil end
		return list[(allIdx - 1) % #list + 1]
	end
	if CFG.FlingMurd then return findRole("Murderer") end
	if CFG.FlingSheriff then return findRole("Sheriff") end
	if CFG.Fling then return nearestOther(CFG.FlingRange) end
	return nil
end

task.spawn(function()
	while running do
		local want = pickFlingTarget()
		if want then
			if want ~= flingTarget or not flingThread then startFling(want) end
		elseif flingThread then stopFling() end
		if CFG.Fling and not CFG.FlingAll and not CFG.FlingMurd and not CFG.FlingSheriff and flingThread and os.clock() - flingStartT > CFG.FlingTime then
			if toggleApply.Fling then toggleApply.Fling(false, true) end
			stopFling()
			notify("fling: time expired", T.Accent2)
		end
		task.wait(0.1)
	end
end)

