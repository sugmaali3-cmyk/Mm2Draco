local function aimHead()
	local cam = workspace.CurrentCamera; local m = UIS:GetMouseLocation(); local best, bestD = nil, CFG.AimFOV
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local c, ok = alive(plr)
			local head = ok and c:FindFirstChild("Head")
			if head then
				local sp, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - m).Magnitude
					if d < bestD then best, bestD = head, d end
				end
			end
		end
	end
	return best
end

