        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLbl.Text = tostring(v)
    end
    apply(CFG[key])

    local function fromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        apply(math.clamp(math.floor((min + (max - min) * a) / step + 0.5) * step, min, max))
    end

    local hit = new("TextButton", {
        Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 18),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5,
    }, row)
    hit.MouseButton1Down:Connect(function(x)
        activeDrag = fromX
        fromX(x)
    end)
