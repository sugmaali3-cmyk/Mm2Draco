-- helpers ------------------------------------------------------------------

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function round(o, s) return new("UICorner", {CornerRadius = s or UDim.new(1, 0)}, o) end
local function corner(o, px) return new("UICorner", {CornerRadius = UDim.new(0, px)}, o) end

local function tw(o, t, props, style, dir)
    local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function reg(o)
    transRegs[#transRegs + 1] = {o, o.BackgroundTransparency}
    return o
end

local function applyTransp()
    local add = CFG.Transp / 100
    for _, r in ipairs(transRegs) do
        if r[1].Parent then r[1].BackgroundTransparency = math.min(0.95, r[2] + add) end
    end
end

local function glass(parent, radius, tr, col)
    local f = new("Frame", {
        BackgroundColor3 = col or C.GLASS, BackgroundTransparency = tr or 0.6, BorderSizePixel = 0,
    }, parent)
    corner(f, radius)
    new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.75, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, f)
    new("UIGradient", {
        Color = ColorSequence.new(Color3.new(1, 1, 1)),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.78),
            NumberSequenceKeypoint.new(0.5, 0.94),
            NumberSequenceKeypoint.new(1, 0.98),
        }),
        Rotation = 90,
    }, f)
    reg(f)
    return f
end

local function hover(btn, base, hi)
    btn.MouseEnter:Connect(function() tw(btn, 0.15, {BackgroundTransparency = hi}) end)
    btn.MouseLeave:Connect(function() tw(btn, 0.25, {BackgroundTransparency = base}) end)
end

local function press(btn)
    local s = new("UIScale", {}, btn)
    btn.MouseButton1Down:Connect(function() tw(s, 0.08, {Scale = 0.93}) end)
    btn.MouseButton1Up:Connect(function() tw(s, 0.35, {Scale = 1}, Enum.EasingStyle.Back) end)
end

local function roleOf(plr)
    local ok, v = pcall(function()
        local c = plr.Character
        local bp = plr:FindFirstChild("Backpack")
        if c and c:FindFirstChild("Knife", true) then return "Murderer" end
        if bp and bp:FindFirstChild("Knife") then return "Murderer" end
        if c and (c:FindFirstChild("Gun", true) or (bp and bp:FindFirstChild("Gun"))) then return "Sheriff" end
        return "Innocent"
    end)
    return ok and v or "Innocent"
end

-- key system ---------------------------------------------------------------

local function checkKey(k)
    k = (k or ""):gsub("%s+", "")
    local exp = KEY_DB[k]
    if exp == nil then return false, "неверный ключ" end
    if exp ~= 0 and os.time() > exp then return false, "ключ истёк" end
    return true, k
end

local function saveKey(k)
    pcall(function() if writefile then writefile(KEY_FILE, k) end end)
end

local function loadKey()
    local ok, data = pcall(function()
        if readfile and isfile and isfile(KEY_FILE) then return readfile(KEY_FILE) end
    end)
    return ok and data or nil
end

local function clearKey()
    pcall(function()
        if delfile and isfile and isfile(KEY_FILE) then delfile(KEY_FILE) end
    end)
end

