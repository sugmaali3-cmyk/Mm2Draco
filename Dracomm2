local flingTarget = nil
local flingConn = nil
local flingSaved = {}
local flingStartT = 0
local allIdx = 0
local allNext = 0

local function saveCollide(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and flingSaved[p] == nil then flingSaved[p] = p.CanCollide end
	end
end

local function restoreCollide()
	for p, v in pairs(flingSaved) do if p.Parent then p.CanCollide = v end; flingSaved[p] = nil end
end

local function stopFling()
	if flingConn then flingConn:Disconnect(); flingConn = nil end
	flingTarget = nil
	restoreCollide()
	
	local c = LP.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")

	if root then
		local bv = root:FindFirstChildOfClass("BodyVelocity")
		if bv then bv:Destroy() end
		local bav = root:FindFirstChildOfClass("BodyAngularVelocity")
		if bav then bav:Destroy() end
		
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	if hum then 
		hum.PlatformStand = false 
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
end

local function startFling(plr)
	stopFling()
	local c = LP.Character
	local root = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	flingTarget = plr
	saveCollide(c)
	
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then p.CanCollide = false end
	end
	
	root.CanCollide = true
	hum.PlatformStand = true

	local bv = Instance.new("BodyVelocity")
	bv.Parent = root
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

	local bav = Instance.new("BodyAngularVelocity")
	bav.Parent = root
	bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

	local toggle = false
	local disabledStates = {Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.PlatformStanding}
	for _, st in ipairs(disabledStates) do pcall(function() hum:SetStateEnabled(st, false) end) end

	flingConn = RunService.Heartbeat:Connect(function()
		local tc = plr.Character
		local tr = tc and tc:FindFirstChild("HumanoidRootPart")
		local th = tc and tc:FindFirstChildOfClass("Humanoid")
		local me = LP.Character
		local myRoot = me and me:FindFirstChild("HumanoidRootPart")
		
		if not running or not tr or not th or th.Health <= 0 or not myRoot or plr.Parent ~= Players then
			stopFling()
			return
		end

		pcall(function() 
			tr:SetNetworkOwner(LP) 
			myRoot:SetNetworkOwner(LP)
		end)

		tr.CanCollide = true
		myRoot.CFrame = tr.CFrame

		toggle = not toggle
		myRoot.CanCollide = toggle

		local power = CFG.FlingPower * 100 
		bv.Velocity = Vector3.new(math.random(-power, power), power, math.random(-power, power))
		bav.AngularVelocity = Vector3.new(power, power, power)

		tr.AssemblyAngularVelocity = Vector3.new(power, power, power)
	end)
end

local function pickFlingTarget()
	if CFG.FlingAll then
		if os.clock() >= allNext then allIdx += 1; allNext = os.clock() + 1.5 end
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then list[#list + 1] = p end end
		if #list == 0 then return nil end
		return list[(allIdx - 1) % #list + 1]
	end
	if CFG.FlingMurd then return findRole("Murderer") end
	if CFG.FlingSheriff then return findRole("Sheriff") end
	if CFG.Fling then return nearestOther(CFG.FlingRange) end
	return nil
end

task.spawn(function()
	while running do
		local want = pickFlingTarget()
		if want then
			if want ~= flingTarget or not flingConn then startFling(want); flingStartT = os.clock() end
		elseif flingConn then stopFling() end

		if CFG.Fling and not CFG.FlingAll and not CFG.FlingMurd and not CFG.FlingSheriff and flingConn and os.clock() - flingStartT > CFG.FlingTime then
			if toggleApply.Fling then toggleApply.Fling(false, true) end
			stopFling()
			notify("fling: время вышло", T.Accent2)
		end
		task.wait(0.1)
	end
end)

