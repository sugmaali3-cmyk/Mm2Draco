local collectedItems = setmetatable({}, {__mode = "k"})

local function getNearestCoin()
	local myRoot = getRoot()
	if not myRoot then return nil end
	local closest = nil
	local minDist = 100 -- Радиус поиска

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name:lower():find("coincontainer") then
			for _, item in ipairs(obj:GetChildren()) do
				if item:IsA("BasePart") and not collectedItems[item] then
					local dist = (item.Position - myRoot.Position).Magnitude
					if dist < minDist then
						minDist = dist
						closest = item
					end
				end
			end
		end
	end
	return closest
end

task.spawn(function()
	while running do
		if CFG.AutoCandy then
			local char = LP.Character
