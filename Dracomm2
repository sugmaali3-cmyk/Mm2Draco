		tween(mainScale, 0.2, {Scale = 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In); tween(blur, 0.2, {Size = 0})
		task.delay(0.2, function() if not isOpen and main.Parent then main.Visible = false; blur.Enabled = false end end)
	end
end

openBtn.MouseButton1Click:Connect(function() setVisible(not isOpen) end)
closeBtn.MouseButton1Click:Connect(function() setVisible(false) end)

track(UIS.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == Enum.KeyCode.RightShift then setVisible(not isOpen) end end))

local fpsCount, fpsTimer, fpsShown = 0, 0, 0
track(RunService.RenderStepped:Connect(function(dt)
	fpsCount += 1; fpsTimer += dt
	if fpsTimer >= 0.5 then
		fpsShown = math.floor(fpsCount / fpsTimer + 0.5); fpsCount, fpsTimer = 0, 0
		local ok, ping = pcall(function() return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		statsLbl.Text = string.format("FPS %d · PING %s", fpsShown, ok and (ping .. "ms") or "--")
	end
end))

task.spawn(function() while running and roleLbl.Parent do local r = roleOf(LP); roleLbl.Text = r; roleLbl.TextColor3 = roleColors[r] or T.Text; task.wait(1) end end)

unload = function()
	running = false
	stopFling(); restoreKnife()
	if lightOrig then applyFullbright(false) end
	for _, c in ipairs(conns) do c:Disconnect() end
	blur:Destroy(); gui:Destroy()
end

setTab("Визуал", 1)

-- Key Gate -----------------------------------------------------------------
local gate = panel(gui, 16, T.Panel, 0.04)
gate.Size = UDim2.fromOffset(340, 214); gate.AnchorPoint = Vector2.new(0.5, 0.5); gate.Position = UDim2.fromScale(0.5, 0.5)
local gateScale = make("UIScale", {}, gate)

make("TextLabel", {Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 18), BackgroundTransparency = 1, Text = "Доступ к Draco Hub", Font = T.FontBold, TextSize = 16, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, gate)
make("TextLabel", {Size = UDim2.new(1, -40, 0, 14), Position = UDim2.fromOffset(20, 40), BackgroundTransparency = 1, Text = "введи лицензионный ключ", Font = T.Font, TextSize = 11, TextColor3 = T.Sub, TextXAlignment = Enum.TextXAlignment.Left}, gate)

local keyBox = make("TextBox", {Size = UDim2.new(1, -40, 0, 38), Position = UDim2.fromOffset(20, 76), BackgroundColor3 = T.Card, BackgroundTransparency = 0.1, BorderSizePixel = 0, Text = "", PlaceholderText = "DRACO-XXXX-XXXX", PlaceholderColor3 = T.Sub, Font = T.FontBold, TextSize = 13, TextColor3 = T.Text, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left}, gate)
radius(keyBox, 9); make("UIPadding", {PaddingLeft = UDim.new(0, 12)}, keyBox)

local gateMsg = make("TextLabel", {Size = UDim2.new(1, -40, 0, 14), Position = UDim2.fromOffset(20, 118), BackgroundTransparency = 1, Text = "", Font = T.Font, TextSize = 10, TextColor3 = T.Bad, TextXAlignment = Enum.TextXAlignment.Left}, gate)
local checkBtn = make("TextButton", {Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, 142), BackgroundColor3 = T.Accent, AutoButtonColor = false, BorderSizePixel = 0, Text = "Проверить", Font = T.FontBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1)}, gate)
radius(checkBtn, 9); make("UIGradient", {Color = ColorSequence.new(T.Accent, T.Accent2), Rotation = 90}, checkBtn); squish(checkBtn)

local function unlockMain()
	CFG.KeyUnlocked = true
	if gate.Parent then tween(gateScale, 0.25, {Scale = 0.85}, Enum.EasingStyle.Quad, Enum.EasingDirection.In); task.delay(0.25, function() gate:Destroy() end) end
	openBtn.Visible = true; notify("добро пожаловать", T.Good); setVisible(true)
end

local function tryKey(k)
	local ok, res = checkKey(k)
	if ok then gateMsg.TextColor3 = T.Good; gateMsg.Text = "ключ принят"; saveKey(res); task.delay(0.3, unlockMain)
	else gateMsg.TextColor3 = T.Bad; gateMsg.Text = res
		tween(gate, 0.05, {Position = UDim2.new(0.5, 6, 0.5, 0)})
		task.delay(0.05, function() tween(gate, 0.05, {Position = UDim2.new(0.5, -6, 0.5, 0)}) end)
		task.delay(0.1, function() tween(gate, 0.05, {Position = UDim2.fromScale(0.5, 0.5)}) end)
	end
end

checkBtn.MouseButton1Click:Connect(function() tryKey(keyBox.Text) end)
keyBox.FocusLost:Connect(function(enter) if enter then tryKey(keyBox.Text) end end)

if CFG.AutoLoadKey then
	local saved = loadKey()
	if saved then
		local ok, res = checkKey(saved)
		if ok then keyBox.Text = res; gateMsg.TextColor3 = T.Good; gateMsg.Text = "ключ найден, вход..."; task.delay(0.4, unlockMain)
		else clearKey() end
	end
end
