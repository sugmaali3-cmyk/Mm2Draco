-- helpers: characters -------------------------------------------------------

local function root(plr)
    local c = plr and plr.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function myRoot() return root(LP) end

local function alive(plr)
    local c = plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0 and root(plr) ~= nil
end

-- ESP ----------------------------------------------------------------------

local function roleColor(r)
    if r == "Murderer" then return C.MURD end
    if r == "Sheriff" then return C.SHER end
    return C.INN
end

local function clearESP(plr)
    local e = espObjs[plr]
    if not e then return end
    if e.hl then e.hl:Destroy() end
    if e.tag then e.tag:Destroy() end
    espObjs[plr] = nil
end

local function ensureESP(plr, c)
    local e = espObjs[plr]
    if e and e.char == c and e.hl.Parent then return e end
    clearESP(plr)
    local hl = new("Highlight", {
        FillTransparency = 0.6, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, c)
    local tag = new("BillboardGui", {
        Size = UDim2.fromOffset(160, 36), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true,
        Adornee = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart"),
    }, c)
    local lbl = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        TextSize = 12, TextStrokeTransparency = 0.4, TextColor3 = C.TXT,
    }, tag)
    e = {char = c, hl = hl, tag = tag, lbl = lbl}
    espObjs[plr] = e
    return e
end

local function updateESP()
    if not CFG.ESP then
        for plr in pairs(espObjs) do clearESP(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr ~= LP and plr.Character
        if c and c:FindFirstChildOfClass("Humanoid") then
            local e = ensureESP(plr, c)
            local role = roleOf(plr)
            local col = roleColor(role)
            e.hl.FillColor = col
            e.hl.OutlineColor = col
            e.tag.Adornee = c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
            e.tag.Enabled = CFG.ESPRole
            e.lbl.TextColor3 = col
            e.lbl.Text = CFG.ESPRole and (plr.DisplayName .. "\n" .. role) or plr.DisplayName
        else
            clearESP(plr)
        end
    end
end

