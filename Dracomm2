local function unload()
    running, killing, flingBusy, flingActive = false, false, false, false
    activeDrag = nil
    antiFlingRestore()
    for _, c in ipairs(conns) do c:Disconnect() end
    for plr in pairs(espObjs) do clearESP(plr) end
    blur:Destroy()
    gui:Destroy()
end

