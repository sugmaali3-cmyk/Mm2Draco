local collectedItems = setmetatable({}, {__mode = "k"})
local CANDY_RADIUS = 5
local CANDY_TIMEOUT = 3.0
local CANDY_PAUSE = 0.3
local candyBV = nil
local candyCoin = nil
local candyTimer = 0

local function getNearestCoin()
	local myRoot = getRoot()
	if not myRoot then return nil end
	local closest, minDist = nil, 150
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name:lower():find("coincontainer") then
			for _, item in ipairs(obj:GetChildren()) do
				if item:IsA("BasePart") and not collectedItems[item] then
					local d = (item.Position - myRoot.Position).Magnitude
					if d < minDist then closest, minDist = item, d end
				end
			end
		end
	end
	return closest
end

local function stopCandyFly()
	if candyBV then candyBV:Destroy(); candyBV = nil end
	candyCoin = nil
	candyTimer = 0
end

local function startCandyFly()
	stopCandyFly()
	local root = getRoot()
	if not root then return end
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = Vector3.zero
	bv.Parent = root
	candyBV = bv
end

task.spawn(function()
	while running do
		if CFG.AutoCandy then
			local char = LP.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if char and hum and hum.Health > 0 and root and not flingThread then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
				if not candyBV or candyBV.Parent ~= root then startCandyFly() end
				local coin = getNearestCoin()
				if coin and candyBV then
					if coin ~= candyCoin then candyCoin = coin; candyTimer = 0 end
					candyTimer += 0.05
					local delta = coin.Position - root.Position
					local dist = delta.Magnitude
					if dist <= CANDY_RADIUS then
						candyBV.Velocity = Vector3.zero
						if firetouchinterest then
							pcall(firetouchinterest, root, coin, 0)
							task.wait(0.01)
							pcall(firetouchinterest, root, coin, 1)
						end
						collectedItems[coin] = true
						candyCoin = nil; candyTimer = 0
						task.wait(CANDY_PAUSE)
					elseif candyTimer >= CANDY_TIMEOUT then
						candyBV.Velocity = Vector3.zero
						collectedItems[coin] = true
						candyCoin = nil; candyTimer = 0
					else
						candyBV.Velocity = delta.Unit * CFG.CandySpeed
					end
				else
					if candyBV then candyBV.Velocity = Vector3.zero end
					candyCoin = nil; candyTimer = 0
				end
