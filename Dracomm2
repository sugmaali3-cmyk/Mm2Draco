local function tryKey(k)
    local ok, res = checkKey(k)
    if ok then
        gateMsg.TextColor3 = C.OK
        gateMsg.Text = "ключ принят"
        saveKey(res)
        task.delay(0.3, unlockMain)
    else
        gateMsg.TextColor3 = C.BAD
        gateMsg.Text = res
        tw(gate, 0.05, {Position = UDim2.new(0.5, 6, 0.5, 0)})
        task.delay(0.05, function() tw(gate, 0.05, {Position = UDim2.new(0.5, -6, 0.5, 0)}) end)
        task.delay(0.1, function() tw(gate, 0.05, {Position = UDim2.fromScale(0.5, 0.5)}) end)
    end
end

