local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function radius(o, px)
	return make("UICorner", {CornerRadius = UDim.new(0, px)}, o)
end

local function stroke(o, tr)
	return make("UIStroke", {
		Color = Color3.new(1, 1, 1), Transparency = tr or 0.88, Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function panel(parent, px, bg, tr)
	local f = make("Frame", {BackgroundColor3 = bg or T.Panel, BackgroundTransparency = tr or 0.08, BorderSizePixel = 0}, parent)
	radius(f, px)
	stroke(f, 0.85)
	make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 225)),
	}, f)
	regs[#regs + 1] = {f, f.BackgroundTransparency}
	return f
end

local function squish(btn)
	local s = make("UIScale", {}, btn)
	btn.MouseButton1Down:Connect(function() tween(s, 0.08, {Scale = 0.95}) end)
	btn.MouseButton1Up:Connect(function() tween(s, 0.4, {Scale = 1}, Enum.EasingStyle.Back) end)
	return s
end

local PX_COL = {
	b = Color3.fromRGB(110, 60, 30), g = Color3.fromRGB(90, 180, 60), O = Color3.fromRGB(60, 25, 0),
