local aura = {}

local function clearAura()
	for _, obj in ipairs(aura) do
		if obj and obj.Parent then obj:Destroy() end
	end
	aura = {}
end

local function buildAura(character)
	clearAura()
	if not CFG.AuraEnabled then return end

	local hrp = character:WaitForChild("HumanoidRootPart")
	local head = character:WaitForChild("Head")
	local color = auraColors[CFG.AuraColorIndex]
	local wingOffset = CFrame.new(0, 0.3, 0.6)
	local hatOffset = CFrame.new(0, 0.85, 0)

	local wings = Instance.new("MeshPart")
	wings.MeshId = WINGS_ID
	wings.Size = Vector3.new(3, 3, 1)
	wings.Material = Enum.Material.Neon
	wings.Color = color
	wings.Transparency = 0.25
	wings.CanCollide = false
	wings.CanTouch = false
	wings.CanQuery = false
	wings.Massless = true
	wings.CastShadow = false
	wings.CFrame = hrp.CFrame * wingOffset
	wings.Parent = character

	local wingWeld = Instance.new("Weld")
	wingWeld.Part0 = hrp
	wingWeld.Part1 = wings
	wingWeld.C0 = wingOffset
	wingWeld.Parent = hrp

	local hat = Instance.new("MeshPart")
	hat.MeshId = HAT_ID
	hat.Size = Vector3.new(1.2, 1.2, 1.2)
	hat.Material = Enum.Material.Neon
	hat.Color = color
	hat.Transparency = 0.1
	hat.CanCollide = false
	hat.CanTouch = false
	hat.CanQuery = false
	hat.Massless = true
	hat.CastShadow = false
	hat.CFrame = head.CFrame * hatOffset
	hat.Parent = character

	local hatWeld = Instance.new("Weld")
	hatWeld.Part0 = head
	hatWeld.Part1 = hat
	hatWeld.C0 = hatOffset
	hatWeld.Parent = head

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 6
	light.Parent = hrp

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(color, Color3.fromRGB(255, 230, 160))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.15, 0)
	sparks.Lifetime = NumberRange.new(0.8, 1.4)
	sparks.Rate = 40
	sparks.Speed = NumberRange.new(1, 3)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Parent = hrp

	table.insert(aura, wings)
	table.insert(aura, wingWeld)
	table.insert(aura, hat)
	table.insert(aura, hatWeld)
	table.insert(aura, light)
	table.insert(aura, sparks)

	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not wings.Parent or not hrp.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		wings.Transparency = 0.2 + (math.sin(t * 3) + 1) * 0.15
		wingWeld.C0 = CFrame.new(0, 0.3 + math.sin(t * 2) * 0.05, 0.6)
			* CFrame.Angles(0, 0, math.rad(math.sin(t * 2) * 4))
		light.Brightness = CFG.AuraBrightness + math.sin(t * 3) * 0.5
	end)
	table.insert(aura, {Destroy = function() conn:Disconnect() end})
end

local function refreshAura()
	if LP.Character then
		buildAura(LP.Character)
	end
end

LP.CharacterAdded:Connect(function(char)
