local function px_rows()
	local function row(pad, s) return string.rep(".", pad) .. s .. string.rep(".", 16 - pad - #s) end
	local function rep(c, n) return string.rep(c, n) end
	return {
		row(7, "bb"), row(6, "bbgg"), row(4, rep("O", 8)), row(2, rep("O", 12)),
		row(2, "O" .. "hh" .. rep("o", 8) .. "O"), row(2, "O" .. rep("o", 10) .. "O"),
		row(2, "O" .. "oo" .. "ee" .. "oo" .. "ee" .. "oo" .. "O"), row(2, "O" .. "oo" .. "ee" .. "oo" .. "ee" .. "oo" .. "O"),
		row(2, "O" .. "oooo" .. "ee" .. "oooo" .. "O"), row(2, "O" .. "oo" .. rep("e", 8) .. "O"),
		row(2, "O" .. "ee" .. "oo" .. "ee" .. "oo" .. "ee" .. "O"), row(2, "O" .. "oo" .. rep("e", 6) .. "oo" .. "O"),
		row(2, "O" .. rep("o", 9) .. "s" .. "O"), row(2, "O" .. rep("s", 10) .. "O"),
		row(2, rep("O", 12)), row(4, rep("O", 8)),
	}
end

local function pumpkin(parent, x, y, cell)
	local box = make("Frame", {Size = UDim2.fromOffset(16 * cell, 16 * cell), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, ZIndex = 5}, parent)
	for r, line in ipairs(px_rows()) do
		for c = 1, 16 do
			local col = PX_COL[line:sub(c, c)]
